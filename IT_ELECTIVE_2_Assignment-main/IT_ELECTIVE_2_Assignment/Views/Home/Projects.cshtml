
@{
    ViewData["Title"] = "Projects";
}

<section id="projects" class="py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-dark"><i class="bi bi-folder-check text-primary me-2"></i>My Projects</h2>
        <p class="text-secondary">@ViewData["Proj 1"]</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <!-- Project 1 -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=500&q=80"
                     class="card-img-top"
                     alt="Project 1 Image"
                     style="height: 200px; object-fit: cover;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">E-Commerce Web Application</h5>
                    <p class="card-text text-secondary">@ViewData["Proj 2"]</p>
                    <div class="mb-3 mt-auto">
                        <span class="badge bg-primary">@ViewData["Proj 3"]</span>
                        <span class="badge bg-secondary">@ViewData["Proj 4"]</span>
                        <span class="badge bg-info text-dark">@ViewData["Proj 5"]</span>
                    </div>
                    <button class="btn btn-outline-primary w-100 mt-2" data-bs-toggle="modal" data-bs-target="#projectModal1">View Details</button>
                </div>
            </div>
        </div>

        <!-- Project 2 -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <img src="https://images.unsplash.com/photo-1611162617213-7d7a39e9b1d7?auto=format&fit=crop&w=500&q=80"
                     class="card-img-top"
                     alt="Project 2 Image"
                     style="height: 200px; object-fit: cover;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@ViewData["Proj 6"]</h5>
                    <p class="card-text text-secondary">@ViewData["Proj 7"]</p>
                    <div class="mb-3 mt-auto">
                        <span class="badge bg-primary">@ViewData["Proj 8"]</span>
                        <span class="badge bg-secondary">@ViewData["Proj 9"]</span>
                        <span class="badge bg-info text-dark">@ViewData["Proj 10"]</span>
                    </div>
                    <button class="btn btn-outline-primary w-100 mt-2" data-bs-toggle="modal" data-bs-target="#projectModal2">View Details</button>
                </div>
            </div>
        </div>

        <!-- Project 3 -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=500&q=80"
                     class="card-img-top"
                     alt="Project 3 Image"
                     style="height: 200px; object-fit: cover;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@ViewData["Proj 11"]</h5>
                    <p class="card-text text-secondary">@ViewData["Proj 12"]</p>
                    <div class="mb-3 mt-auto">
                        <span class="badge bg-primary">C#</span>
                        <span class="badge bg-secondary">Entity Framework</span>
                        <span class="badge bg-info text-dark">Bootstrap</span>
                    </div>
                    <button class="btn btn-outline-primary w-100 mt-2" data-bs-toggle="modal" data-bs-target="#projectModal3">View Details</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Simple Modals for Project "View Details" Buttons -->
<div class="modal fade" id="projectModal1" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">E-Commerce Web Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @ViewData["Proj 13"]
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="projectModal2" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Task Management Board</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @ViewData["Proj 14"]
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="projectModal3" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Student Progress Tracker</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @ViewData["Proj 15"]
            </div>
        </div>
    </div>
</div>

<div class="my-5" />

