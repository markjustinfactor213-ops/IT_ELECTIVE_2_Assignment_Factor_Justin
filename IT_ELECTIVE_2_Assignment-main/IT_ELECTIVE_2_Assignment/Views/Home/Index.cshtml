@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-5">
    <div class="row align-items-center">

        <!-- Profile Photo Column -->
        <div class="col-lg-5 text-center">
            <img src="~/images/image.png" alt="Professional Profile Photo" class="img-fluid rounded-circle shadow-lg border border-4 border-white" style="width: 280px; height: 280px; object-fit: cover;" />
        </div>

        <!-- Profile Bio Column (Put your name and text here!) -->
        <div class="col-lg-7">
            <h1 class="display-4 fw-bold">Justin Factor</h1>
            <p class="lead">Aspiring Full-Stack Web Developer</p>
            <p>Welcome to my portfolio website! Here you can check out my latest work, technical skills, and academic background.</p>
        </div>

    </div>
</div>  

<!-- Projects Section -->
<div class="container my-5">
    <hr class="my-5" />
    <h2 class="text-center mb-4 fw-bold">My Projects</h2>

    <div class="row g-4">

        <!-- Project Card 1 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-dark text-white">
                <!-- Card Image (Using a placeholder, you can swap later) -->
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=500" class="card-img-top" alt="Project 1" style="height: 180px; object-fit: cover;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Portfolio Website</h5>
                    <p class="card-text flex-grow-1">A personal portfolio website built using ASP.NET Core MVC and styled with Bootstrap to showcase my web development journey.</p>
                    <!-- Bootstrap Button -->
                    <a href="#" class="btn btn-primary mt-3">View Details</a>
                </div>
            </div>
        </div>

        <!-- Project Card 2 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-dark text-white">
                <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=500" class="card-img-top" alt="Project 2" style="height: 180px; object-fit: cover;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Student Management System</h5>
                    <p class="card-text flex-grow-1">An MVC-based web application designed to handle student enrollment, course grading, and database management.</p>
                    <!-- Bootstrap Button -->
                    <a href="#" class="btn btn-outline-light mt-3">View Project</a>
                </div>
            </div>
        </div>

        <!-- Project Card 3 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-dark text-white">
                <img src="https://images.unsplash.com/photo-1542831371-29b0f74f9713?w=500" class="card-img-top" alt="Project 3" style="height: 180px; object-fit: cover;">

                <div class="card-body d-flex flex-column text-white">
                    <h5 class="card-title fw-bold">E-Commerce App</h5>
                    <p class="card-text flex-grow-1">A mock shopping portal with a fully functional shopping cart, secure checkout process, and admin control panels.</p>
                    <!-- Bootstrap Button -->
                    <a href="#" class="btn btn-outline-light mt-3">GitHub Code</a>
                </div>
            </div>
        </div>

    </div>
</div>

