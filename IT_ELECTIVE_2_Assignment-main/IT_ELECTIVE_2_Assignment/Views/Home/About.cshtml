
@{
    ViewData["Title"] = "About";
}

<section id="about" class="py-5">
    <div class="row">
        <div class="col-12">
            <h2 class="display-5 fw-bold mb-4 text-dark text-center text-md-start"><i class="bi bi-person-workspace text-primary me-2"></i>About Me</h2>
        </div>
        <div class="col-lg-8">
            <p class="fs-5 text-secondary">
                @ViewData["info 1"]
            </p>
            <p class="fs-5 text-secondary">
                @ViewData["info 2"]
            </p>
        </div>
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card border-0 bg-light shadow-sm p-4 h-100">
                <h4 class="fw-bold mb-3">Quick Facts</h4>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><strong>Degree:</strong> @ViewData["Fact1"]</li>
                    <li class="mb-2"><strong>Focus:</strong> @ViewData["Fact2"]</li>
                    <li class="mb-2"><strong>Key Interests:</strong> @ViewData["Fact3"]</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<div class="my-5" />

