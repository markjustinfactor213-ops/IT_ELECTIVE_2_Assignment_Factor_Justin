
@{

    ViewData["Title"] = "Skills";

}

<section id="skills" class="py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-dark"><i class="bi bi-lightning-charge text-primary me-2"></i>My Skills</h2>
        <p class="text-secondary">@ViewData["skill 1"]</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        <!-- Card 1: Programming Languages -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="card-body">
                    <div class="fs-1 text-primary mb-3"><i class="bi bi-file-earmark-code"></i></div>
                    <h5 class="card-title fw-bold">@ViewData["Prog 1"]</h5>
                    <p class="card-text text-secondary">@ViewData["Prog 2"]</p>
                </div>
            </div>
        </div>

        <!-- Card 2: Web Technologies -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="card-body">
                    <div class="fs-1 text-success mb-3"><i class="bi bi-globe"></i></div>
                    <h5 class="card-title fw-bold">@ViewData["Web 1"]</h5>
                    <p class="card-text text-secondary">@ViewData["Web 2"]</p>
                </div>
            </div>
        </div>

        <!-- Card 3: Databases -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="card-body">
                    <div class="fs-1 text-warning mb-3"><i class="bi bi-database"></i></div>
                    <h5 class="card-title fw-bold">@ViewData["Data 1"]</h5>
                    <p class="card-text text-secondary">@ViewData["Data 2"]</p>
                </div>
            </div>
        </div>

        <!-- Card 4: Development Tools -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="card-body">
                    <div class="fs-1 text-danger mb-3"><i class="bi bi-tools"></i></div>
                    <h5 class="card-title fw-bold">@ViewData["Dev 1"]</h5>
                    <p class="card-text text-secondary">@ViewData["Dev 2"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="my-5" />

