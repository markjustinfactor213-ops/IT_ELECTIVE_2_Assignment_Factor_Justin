
@{
    ViewData["Title"] = "Contact";
}

<section id="contact" class="py-5 mb-5">
    <div class="row align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h2 class="display-5 fw-bold text-dark"><i class="bi bi-telephone-outbound text-primary me-2"></i>Get In Touch</h2>
            <p class="text-secondary fs-5 mt-3">
                @ViewData["Cont 1"]
            </p>
            <div class="mt-4">
                <div class="d-flex align-items-center mb-3">
                    <span class="fs-4 text-primary me-3"><i class="bi bi-envelope-at"></i></span>
                    <div>
                        <small class="text-muted d-block">@ViewData["Cont 2"]</small>
                        <a href="mailto:factorjustin@gamil.com" class="text-decoration-none text-dark fw-semibold">@ViewData["Cont 3"]</a>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="fs-4 text-primary me-3"><i class="bi bi-phone"></i></span>
                    <div>
                        <small class="text-muted d-block">@ViewData["Cont 4"]</small>
                        <span class="text-dark fw-semibold">@ViewData["Cont 5"]</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Social Profiles Card & Resume Download Button -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4 bg-white rounded-3">
                <h4 class="fw-bold mb-4">My Online Profiles</h4>

                <div class="d-flex flex-column gap-3 mb-4">
                    <a href="https://github.com/Justin" target="_blank" class="btn btn-light text-start py-2 fs-6"><i class="bi bi-github me-3 text-dark"></i> GitHub Profile</a>
                    <a href="https://linkedin.com" target="_blank" class="btn btn-light text-start py-2 fs-6"><i class="bi bi-linkedin me-3 text-primary"></i> LinkedIn Profile</a>
                    <a href="https://facebook.com" target="_blank" class="btn btn-light text-start py-2 fs-6"><i class="bi bi-facebook me-3 text-primary"></i> Facebook Profile (Optional)</a>
                </div>

                <hr class="my-3" />

                <!-- Download Resume Button -->
                <button class="btn btn-primary w-100 btn-lg py-3"><i class="bi bi-cloud-arrow-down me-2"></i>Download Resume</button>
            </div>
        </div>
    </div>
</section>

